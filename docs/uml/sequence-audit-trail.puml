@startuml
actor Admin
participant "View (Blade/UI)" as View
participant "AuditController" as Controller
participant "AuditLog (Model)" as Model
database "MySQL" as DB

Admin -> View : Buka Halaman Audit Trail dengan Filter (Tgl/Aktor)
View -> Controller : GET /admin/audit-logs?date=...

Controller -> Model : filterLogs(filters)
Model -> DB : SELECT * FROM audit_logs WHERE ...
DB --> Model : results
Model --> Controller : Collection<AuditLog>

Controller --> View : render('admin.audit', logs)
View --> Admin : Tampilkan Tabel Riwayat Aktivitas (Old vs New Data)
@enduml
